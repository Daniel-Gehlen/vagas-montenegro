{
  "name": "vagas-montenegro",
  "version": "1.0.0",
  "description": "Sistema de busca de vagas em Montenegro/RS",
  "type": "module",
  "scripts": {
    "serve": "php -S localhost:8080 -t .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "api": "php -S localhost:8080 -t .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "test:accessibility": "playwright test accessibility.spec.js",
    "test:links": "linkinator http://localhost:8080 --recurse --silent --format json > reports/link-check.json",
    "test:spelling": "cspell '**/*.{js,html,css,md}' --config cspell.config.js",
    "ci": "npm run lint && npm run format && npm run test:spelling && npm run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^30.3.0",
    "cspell": "^8.14.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-testing-library": "^7.16.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-puppeteer": "^11.0.0",
    "linkinator": "^6.1.2",
    "prettier": "^3.3.3",
    "puppeteer": "^24.39.1",
    "supertest": "^7.0.0",
    "vite": "^5.4.10"
  }
}
